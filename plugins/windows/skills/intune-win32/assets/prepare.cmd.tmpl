@echo off
setlocal enabledelayedexpansion
rem ============================================================
rem  {{PKGNAME}} - Quell-Image bereitstellen
rem  Als ADMINISTRATOR starten. Ergebnis: App\Image\{{EXPECTFILE}}
rem  Protokoll: extract.log
rem  Danach Pack.cmd starten.
rem ============================================================
set "BASE=%~dp0"
set "SRC=%BASE%{{SOURCEFILE}}"
set "IMG=%BASE%App\Image"
set "LOG=%BASE%extract.log"

echo ============================================ >"%LOG%"
echo Start: %DATE% %TIME% >>"%LOG%"

if not exist "%SRC%" (
  echo FEHLER: %SRC% nicht gefunden.
  echo FEHLER: Quelldatei fehlt >>"%LOG%"
  pause & exit /b 1
)
if not exist "%IMG%" mkdir "%IMG%"

echo.
echo [1/3] Versuche herstellereigenen Entpacker ...
echo [1/3] Herstellereigener Entpacker >>"%LOG%"
"%SRC%" {{VENDORARGS}} "%IMG%" >>"%LOG%" 2>&1
call :findfile && goto :done

echo [2/3] Nicht erfolgreich - versuche 7-Zip ...
echo [2/3] 7-Zip >>"%LOG%"
set "SZ=%ProgramFiles%\7-Zip\7z.exe"
if not exist "!SZ!" set "SZ=%ProgramFiles(x86)%\7-Zip\7z.exe"
if not exist "!SZ!" (
  echo 7-Zip nicht gefunden - bitte installieren: https://www.7-zip.org/
  echo 7-Zip nicht gefunden >>"%LOG%"
) else (
  "!SZ!" x "%SRC%" -o"%IMG%" -y >>"%LOG%" 2>&1
  call :findfile && goto :done
)

echo.
echo [3/3] FEHLGESCHLAGEN. Bitte extract.log ansehen.
echo Alternativ die Datei von Hand nach App\Image entpacken,
echo sodass App\Image\{{EXPECTFILE}} existiert.
echo FEHLGESCHLAGEN >>"%LOG%"
pause & exit /b 1

:done
echo.
echo FERTIG. App\Image\{{EXPECTFILE}} ist vorhanden.
for /f "delims=" %%S in ('dir /s /-c "%IMG%" ^| find "Datei(en)"') do echo %%S
echo Jetzt Pack.cmd starten.
echo OK: %DATE% %TIME% >>"%LOG%"
pause & exit /b 0

rem --- prueft das Ergebnis und zieht verschachtelte Ordner hoch -------------
:findfile
if exist "%IMG%\{{EXPECTFILE}}" exit /b 0
for /f "delims=" %%F in ('dir /b /s "%IMG%\{{EXPECTFILE}}" 2^>nul') do (
  set "FOUND=%%~dpF"
  echo Normalisiere: !FOUND! >>"%LOG%"
  robocopy "!FOUND!." "%IMG%" /E /MOVE /NFL /NDL /NJH /NJS /NP >>"%LOG%" 2>&1
  if exist "%IMG%\{{EXPECTFILE}}" exit /b 0
)
exit /b 1
